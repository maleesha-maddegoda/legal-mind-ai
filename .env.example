# ==============================================================================
# AI Legal Analyzer & Risk Predictor - Environment Configuration Example
# ==============================================================================
# Copy this file or the backend-specific template (`backend/.env.example`) to:
#   backend/.env
#
# If customizing frontend API endpoints, copy `frontend/.env.example` to:
#   frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend - MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=legal_analyzer_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# Backend - Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikeys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL_FALLBACK=gemini-2.0-flash
GEMINI_SEPARATE_CALLS=false

# ------------------------------------------------------------------------------
# Backend - Google Calendar Sync (Optional)
# ------------------------------------------------------------------------------
CALENDAR_TZ=UTC
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# Frontend - React Configuration
# ------------------------------------------------------------------------------
REACT_APP_API_URL=http://127.0.0.1:8000
