# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to `backend/.env` and update the values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=legal_analyzer_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikeys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Override model specifically for summarization
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL_FALLBACK=gemini-2.0-flash

# Optional: Separate analysis calls (true/false)
GEMINI_SEPARATE_CALLS=false

# ------------------------------------------------------------------------------
# Google Calendar Sync (Optional)
# ------------------------------------------------------------------------------
CALENDAR_TZ=UTC
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
